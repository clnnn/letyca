<html>

<head>
  <meta charset='utf-8' />
  <title>{{title}}</title>

</head>

<body>
  <div>
    <canvas id='myChart'></canvas>
  </div>
</body>
<script src='https://cdn.jsdelivr.net/npm/chart.js'></script>
<script>

  const ctx = document.getElementById('myChart'); new Chart(ctx, {
    type: '{{ chartType }}',
    data: {{{ data }}}, options: { scales: { y: { beginAtZero: true } } }
  });
</script>

</html>