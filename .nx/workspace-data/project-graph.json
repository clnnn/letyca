{
  "nodes": {
    "server-e2e": {
      "name": "server-e2e",
      "type": "e2e",
      "data": {
        "root": "apps/server-e2e",
        "name": "server-e2e",
        "$schema": "../../node_modules/nx/schemas/project-schema.json",
        "projectType": "application",
        "implicitDependencies": [
          "server"
        ],
        "targets": {
          "e2e": {
            "executor": "@nx/jest:jest",
            "outputs": [
              "{workspaceRoot}/coverage/{e2eProjectRoot}"
            ],
            "options": {
              "jestConfig": "apps/server-e2e/jest.config.ts",
              "passWithNoTests": true
            },
            "configurations": {
              "ci": {
                "ci": true,
                "codeCoverage": true
              }
            },
            "parallelism": true,
            "cache": true,
            "inputs": [
              "default",
              "^production",
              "{workspaceRoot}/jest.preset.js"
            ]
          },
          "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": [
              "{options.outputFile}"
            ],
            "configurations": {},
            "options": {},
            "parallelism": true,
            "inputs": [
              "default",
              "{workspaceRoot}/.eslintrc.json",
              "{workspaceRoot}/.eslintignore",
              "{workspaceRoot}/eslint.config.js"
            ],
            "cache": true
          }
        },
        "tags": []
      }
    },
    "client": {
      "name": "client",
      "type": "app",
      "data": {
        "root": "apps/client",
        "name": "client",
        "$schema": "../../node_modules/nx/schemas/project-schema.json",
        "projectType": "application",
        "prefix": "le",
        "sourceRoot": "apps/client/src",
        "tags": [
          "type:app",
          "scope:client"
        ],
        "targets": {
          "build": {
            "executor": "@angular-devkit/build-angular:browser",
            "outputs": [
              "{options.outputPath}"
            ],
            "options": {
              "outputPath": "dist/apps/client",
              "index": "apps/client/src/index.html",
              "main": "apps/client/src/main.ts",
              "polyfills": [
                "zone.js"
              ],
              "tsConfig": "apps/client/tsconfig.app.json",
              "assets": [
                "apps/client/src/favicon.ico",
                "apps/client/src/assets",
                {
                  "glob": "**/*",
                  "input": "node_modules/@taiga-ui/icons/src",
                  "output": "assets/taiga-ui/icons"
                }
              ],
              "styles": [
                "@taiga-ui/core/styles/taiga-ui-theme.less",
                "@taiga-ui/core/styles/taiga-ui-fonts.less",
                "@taiga-ui/styles/taiga-ui-global.less",
                "apps/client/src/styles.scss"
              ],
              "scripts": []
            },
            "configurations": {
              "production": {
                "budgets": [
                  {
                    "type": "initial",
                    "maximumWarning": "500kb",
                    "maximumError": "20mb"
                  },
                  {
                    "type": "anyComponentStyle",
                    "maximumWarning": "2kb",
                    "maximumError": "100kb"
                  }
                ],
                "outputHashing": "all"
              },
              "development": {
                "buildOptimizer": false,
                "optimization": false,
                "vendorChunk": true,
                "extractLicenses": false,
                "sourceMap": true,
                "namedChunks": true
              }
            },
            "defaultConfiguration": "production",
            "parallelism": true,
            "dependsOn": [
              "^build"
            ],
            "inputs": [
              "production",
              "^production"
            ],
            "cache": true
          },
          "serve": {
            "executor": "@angular-devkit/build-angular:dev-server",
            "configurations": {
              "production": {
                "buildTarget": "client:build:production"
              },
              "development": {
                "buildTarget": "client:build:development"
              }
            },
            "defaultConfiguration": "development",
            "options": {
              "proxyConfig": "apps/client/proxy.conf.json"
            },
            "parallelism": true
          },
          "extract-i18n": {
            "executor": "@angular-devkit/build-angular:extract-i18n",
            "options": {
              "buildTarget": "client:build"
            },
            "configurations": {},
            "parallelism": true
          },
          "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": [
              "{options.outputFile}"
            ],
            "configurations": {},
            "options": {},
            "parallelism": true,
            "inputs": [
              "default",
              "{workspaceRoot}/.eslintrc.json",
              "{workspaceRoot}/.eslintignore",
              "{workspaceRoot}/eslint.config.js"
            ],
            "cache": true
          },
          "test": {
            "executor": "@nx/jest:jest",
            "outputs": [
              "{workspaceRoot}/coverage/{projectRoot}"
            ],
            "options": {
              "jestConfig": "apps/client/jest.config.ts",
              "passWithNoTests": true
            },
            "configurations": {
              "ci": {
                "ci": true,
                "codeCoverage": true
              }
            },
            "parallelism": true,
            "cache": true,
            "inputs": [
              "default",
              "^production",
              "{workspaceRoot}/jest.preset.js"
            ]
          }
        },
        "implicitDependencies": []
      }
    },
    "server": {
      "name": "server",
      "type": "app",
      "data": {
        "root": "apps/server",
        "name": "server",
        "$schema": "../../node_modules/nx/schemas/project-schema.json",
        "sourceRoot": "apps/server/src",
        "projectType": "application",
        "tags": [],
        "targets": {
          "build": {
            "executor": "@nx/webpack:webpack",
            "outputs": [
              "{options.outputPath}"
            ],
            "defaultConfiguration": "production",
            "options": {
              "target": "node",
              "compiler": "tsc",
              "outputPath": "dist/apps/server",
              "main": "apps/server/src/main.ts",
              "tsConfig": "apps/server/tsconfig.app.json",
              "assets": [
                "apps/server/src/assets",
                "apps/server/src/views"
              ],
              "webpackConfig": "apps/server/webpack.config.js",
              "styles": [
                "node_modules/@taiga-ui/core/styles/taiga-ui-theme.less",
                "node_modules/@taiga-ui/core/styles/taiga-ui-fonts.less",
                "node_modules/@taiga-ui/styles/taiga-ui-global.less"
              ]
            },
            "configurations": {
              "development": {},
              "production": {}
            },
            "parallelism": true,
            "dependsOn": [
              "^build"
            ],
            "inputs": [
              "production",
              "^production"
            ],
            "cache": true
          },
          "serve": {
            "executor": "@nx/js:node",
            "defaultConfiguration": "development",
            "options": {
              "buildTarget": "server:build"
            },
            "configurations": {
              "development": {
                "buildTarget": "server:build:development"
              },
              "production": {
                "buildTarget": "server:build:production"
              }
            },
            "parallelism": true
          },
          "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": [
              "{options.outputFile}"
            ],
            "configurations": {},
            "options": {},
            "parallelism": true,
            "inputs": [
              "default",
              "{workspaceRoot}/.eslintrc.json",
              "{workspaceRoot}/.eslintignore",
              "{workspaceRoot}/eslint.config.js"
            ],
            "cache": true
          },
          "test": {
            "executor": "@nx/jest:jest",
            "outputs": [
              "{workspaceRoot}/coverage/{projectRoot}"
            ],
            "options": {
              "jestConfig": "apps/server/jest.config.ts",
              "passWithNoTests": true
            },
            "configurations": {
              "ci": {
                "ci": true,
                "codeCoverage": true
              }
            },
            "parallelism": true,
            "cache": true,
            "inputs": [
              "default",
              "^production",
              "{workspaceRoot}/jest.preset.js"
            ]
          }
        },
        "implicitDependencies": []
      }
    },
    "contracts": {
      "name": "contracts",
      "type": "lib",
      "data": {
        "root": "contracts",
        "name": "contracts",
        "$schema": "../node_modules/nx/schemas/project-schema.json",
        "sourceRoot": "contracts/src",
        "prefix": "le",
        "projectType": "library",
        "tags": [],
        "targets": {
          "test": {
            "executor": "@nx/jest:jest",
            "outputs": [
              "{workspaceRoot}/coverage/{projectRoot}"
            ],
            "options": {
              "jestConfig": "contracts/jest.config.ts",
              "passWithNoTests": true
            },
            "configurations": {
              "ci": {
                "ci": true,
                "codeCoverage": true
              }
            },
            "parallelism": true,
            "cache": true,
            "inputs": [
              "default",
              "^production",
              "{workspaceRoot}/jest.preset.js"
            ]
          },
          "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": [
              "{options.outputFile}"
            ],
            "configurations": {},
            "options": {},
            "parallelism": true,
            "inputs": [
              "default",
              "{workspaceRoot}/.eslintrc.json",
              "{workspaceRoot}/.eslintignore",
              "{workspaceRoot}/eslint.config.js"
            ],
            "cache": true
          }
        },
        "implicitDependencies": []
      }
    }
  },
  "externalNodes": {},
  "dependencies": {
    "server-e2e": [
      {
        "source": "server-e2e",
        "target": "server",
        "type": "implicit"
      }
    ],
    "client": [
      {
        "source": "client",
        "target": "contracts",
        "type": "static"
      }
    ],
    "server": [
      {
        "source": "server",
        "target": "contracts",
        "type": "static"
      }
    ],
    "contracts": []
  },
  "version": "6.0"
}